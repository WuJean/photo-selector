# Copy to .env only if defaults need changing. Do not put API keys here.
PHOTO_SELECTOR_PORT=4173
PHOTO_SELECTOR_BIND=0.0.0.0
# Leave unset for automatic LAN address detection by deploy.sh.
# PHOTO_SELECTOR_PUBLIC_URL=https://photos.example.com
# Additional exact allowed origins, comma separated; no wildcard CORS.
# PHOTO_SELECTOR_ALLOWED_ORIGINS=http://192.168.1.20:4173
# Native data directory; does not select a Docker volume.
# PHOTO_SELECTOR_DATA_DIR=.local
PHOTO_SELECTOR_VOLUME=photo-selector-data
TZ=Asia/Shanghai
