{
  "name": "photo-selector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --watch-path=server --watch-path=shared server/index.mjs",
    "start": "node server/index.mjs",
    "build": "vite build",
    "test": "node --test test/*.test.mjs",
    "check": "npm run test && npm run build",
    "test:browser": "playwright test",
    "build:vision": "swift build -c release --product VisionWorker",
    "test:all": "npm run check && npm run test:browser",
    "benchmark": "node scripts/benchmark.mjs",
    "format": "prettier --write \"server/**/*.mjs\" \"shared/**/*.mjs\" \"web/src/**/*.{js,jsx,css}\" \"test/**/*.{mjs,js}\" \"scripts/*.mjs\" *.js *.json",
    "build:wechat": "node scripts/build-wechat.mjs",
    "sync:wechat": "node scripts/build-wechat.mjs --sync",
    "test:wechat": "node --test wechat/test/*.test.mjs",
    "package:wechat": "npm run build:wechat && node scripts/package-wechat-cloud.mjs",
    "test:docker": "node scripts/docker-smoke.mjs"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "exifr": "^7.1.3",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-react": "^5.0.4",
    "prettier": "^3.9.10",
    "vite": "^7.1.9"
  }
}
