<view class="page"><view class="row between"><view class="title">我的旅行</view><button class="primary" bindtap="create">创建项目</button></view><view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">重试</button></view><view wx:if="{{!projects.length && !loading && !error}}" class="empty">创建项目，开始选片</view><view wx:for="{{projects}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="open">{{item.name}}<view class="muted">进入照片库 →</view></view></view>
