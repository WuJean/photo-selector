<view class="page"><view class="title">AI 分类</view><view class="muted">{{settings.model}}</view><view wx:if="!settings.configured || !settings.workerReady" class="error">管理员需先配置 AI 服务与异步执行器</view><view wx:if="!job" class="card"><button class="primary" data-type="classify" bindtap="start" disabled="{{busy}}">按现有标签直接分类</button></view><tasks project-id="{{projectId}}"/><view wx:if="!job || job.state==='confirmation'"><view class="section">{{job?'确认候选标签':'细化分类 · 补充常用标签'}}</view><view class="row"><button wx:for="{{tags}}" wx:key="name" class="small {{item.enabled?'primary':''}}" data-index="{{index}}" bindtap="toggle">{{item.name}}</button></view><view class="spacer"/><input placeholder="补充标签，用逗号分隔" value="{{extra}}" bindinput="extra"/><view class="row"><button class="small" bindtap="add">添加</button><button wx:if="!job" data-type="sample" bindtap="start" disabled="{{busy}}">确认并抽样</button><button wx:else class="primary" bindtap="confirm" disabled="{{busy}}">确认并开始分类</button></view></view><view wx:if="job.state==='done'" class="card">已完成</view></view>
