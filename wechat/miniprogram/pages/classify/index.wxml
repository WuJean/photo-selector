<view class="page"><view class="row between"><text class="title">AI 分类</text><button size="mini" class="small" bindtap="advanced">设置</button></view><view class="muted">{{settings.model}}</view><view wx:if="{{!settings.configured || !settings.workerReady}}" class="error">管理员需先配置 AI 服务与异步执行器</view><view wx:if="{{!job || job.state==='done' || job.state==='cancelled'}}" class="card"><button size="mini" class="primary" data-type="classify" bindtap="start" disabled="{{busy}}">按现有标签直接分类</button><view class="row"><button size="mini" class="small" bindtap="refine">细化分类</button><button size="mini" class="small" data-type="classify" data-force="{{true}}" bindtap="start" disabled="{{busy}}">重新分析</button></view></view><tasks project-id="{{projectId}}" bindprogress="progress"/><view wx:if="{{refining || job.state==='confirmation'}}"><view class="section">{{job.state==='confirmation'?'确认候选标签':'补充常用标签'}}</view><view wx:for="{{domains}}" wx:key="name"><view class="section">{{item.name}}</view><view class="row"><button size="mini" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="name" class="small {{tag.enabled?'primary':''}}" data-index="{{tag.index}}" bindtap="toggle">{{tag.name}}</button></view></view><view class="spacer"/><input placeholder="补充标签，用逗号分隔" value="{{extra}}" bindinput="extra"/><view class="row"><button size="mini" class="small" bindtap="add">添加</button><button size="mini" wx:if="{{job.state!=='confirmation'}}" data-type="sample" bindtap="start" disabled="{{busy}}">确认并抽样</button><button size="mini" wx:else class="primary" bindtap="confirm" disabled="{{busy}}">确认并开始分类</button></view></view><view wx:if="{{advanced}}" class="card"><view>抽样并发 {{settings.sampleConcurrency}}</view><slider min="1" max="16" value="{{settings.sampleConcurrency}}" data-key="sampleConcurrency" bindchange="concurrency"/><view>打标并发 {{settings.classifyConcurrency}}</view><slider min="1" max="16" value="{{settings.classifyConcurrency}}" data-key="classifyConcurrency" bindchange="concurrency"/><view>服务总并发 {{settings.serviceConcurrency}}</view><slider min="1" max="16" value="{{settings.serviceConcurrency}}" data-key="serviceConcurrency" bindchange="concurrency"/></view></view>