<view class="page"><view class="row toolbar"><button class="{{stage==='rough'?'primary':''}}" data-stage="rough" bindtap="stage">粗筛 {{counts.rough || 0}}</button><button class="{{stage==='refine'?'primary':''}}" data-stage="refine" bindtap="stage">精筛 {{counts.refine || 0}}</button><button data-stage="portfolio" bindtap="stage">作品集</button></view><view class="row"><button class="small" bindtap="upload" disabled="{{uploading}}">导入照片</button><button class="small" bindtap="filters">筛选</button><button class="small" bindtap="processed">{{processed?'待筛选':'已处理'}}</button><button class="small" bindtap="undo">撤销</button><button class="small" bindtap="foldAll">{{expanded.length?'全部叠放':'全部展开'}}</button><button wx:if="stage==='refine'" class="small" bindtap="ai">AI 分类</button><button class="small" bindtap="selectMode">{{choosing?'完成多选':'多选'}}</button></view><view wx:if="uploadTotal &amp;&amp; uploadDone &lt; uploadTotal" class="card">上传 {{uploadDone}} / {{uploadTotal}}<progress percent="{{uploadDone / uploadTotal * 100}}" activeColor="#d3ec8c"/><button wx:if="!uploading" bindtap="resumeUpload">继续／重试 {{uploadFailures}}</button></view><view wx:if="error" class="error">{{error}}<button bindtap="retry">重试</button></view><view class="spacer"/><view class="grid"><view wx:for="{{cards}}" wx:key="id" class="photo {{item.selected?'chosen':''}}"><image wx:if="!item.imageError" src="{{item.url}}" mode="aspectFill" lazy-load data-id="{{item.id}}" bindtap="open" binderror="imageError"/><button wx:else data-id="{{item.id}}" bindtap="retryImage">图片加载失败 · 重试</button><view wx:if="item.count>1" class="badge" data-id="{{item.groupId}}" bindtap="group">{{item.expanded?'收起本组':'相似'}} {{item.count}}</view><view><text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" class="tag">{{tag}}</text></view><view class="row"><button wx:if="stage==='rough'" class="small" data-id="{{item.id}}" data-value="maybe" bindtap="decide">待定</button><button class="small" data-id="{{item.id}}" data-value="keep" bindtap="decide">保留</button><button class="small" data-id="{{item.id}}" data-value="reject" bindtap="decide">不要</button></view></view></view><view wx:if="!cards.length &amp;&amp; !loading" class="empty">当前范围已筛完<button wx:if="stage==='rough'" data-stage="refine" bindtap="stage">进入精筛</button><button wx:else data-stage="portfolio" bindtap="stage">进入作品集</button></view><view wx:if="more" class="empty" bindtap="retry">{{loading?'加载中…':'上滑继续加载'}}</view></view><view wx:if="filterOpen" class="sheet"><view class="sheet-body bottom"><view class="row between"><text class="section">筛选</text><button class="small" bindtap="mode">{{filter.tagMode==='all'?'同时满足':'满足任一'}}</button></view><picker range="{{focals}}" bindchange="focal"><view class="card">{{filter.focal||'全部焦段'}} ▾</view></picker><view class="row"><button class="small" data-value="" bindtap="orientation">全部方向</button><button class="small" data-value="portrait" bindtap="orientation">竖图</button><button class="small" data-value="landscape" bindtap="orientation">横图</button></view><view wx:for="{{domains}}" wx:key="name"><view class="section">{{item.name}}</view><view class="row"><button wx:for="{{item.options}}" wx:for-item="tag" wx:key="name" class="small {{tag.selected?'primary':''}}" data-tag="{{tag.name}}" bindtap="tag">{{tag.name}}</button></view></view><view class="spacer"/><view class="row"><button bindtap="clearFilters">重置</button><button class="primary" bindtap="applyFilters">应用</button></view></view></view>
