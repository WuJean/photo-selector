<view class="page"><view class="row between toolbar"><view class="title">照片库</view><button class="primary" bindtap="upload" disabled="{{uploading}}">导入照片</button></view><view wx:if="uploading" class="card">上传 {{uploadDone}} / {{uploadTotal}}<progress percent="{{uploadDone / uploadTotal * 100}}" activeColor="#d3ec8c"/></view><view wx:if="error" class="error">{{error}}<button bindtap="retry">重试</button></view><view class="grid"><view wx:for="{{photos}}" wx:key="id" class="photo"><image src="{{item.url}}" mode="aspectFill" lazy-load/><view class="muted">{{item.name}}</view></view></view><view wx:if="!photos.length &amp;&amp; !loading" class="empty">导入这次旅行的照片</view></view>
