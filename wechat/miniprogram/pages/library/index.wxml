<view class="page"><view class="row toolbar nav"><button size="mini" class="{{stage==='rough'?'primary':''}}" data-stage="rough" bindtap="stage">粗筛 {{counts.rough || 0}}</button><button size="mini" class="{{stage==='refine'?'primary':''}}" data-stage="refine" bindtap="stage">精筛 {{counts.refine || 0}}</button><button size="mini" data-stage="portfolio" bindtap="stage">作品集</button></view><view class="row"><button size="mini" class="small" bindtap="upload" disabled="{{uploading}}">导入照片</button><button size="mini" class="small" bindtap="filters">筛选</button><button size="mini" class="small" bindtap="processed">{{processed?'待筛选':'已处理'}}</button><button size="mini" class="small" bindtap="undo">撤销</button><button size="mini" class="small" bindtap="foldAll">{{expanded.length?'全部叠放':'全部展开'}}</button><button size="mini" wx:if="{{stage==='refine'}}" class="small" bindtap="ai">AI 分类</button><button size="mini" class="small" bindtap="selectMode">{{choosing?'完成多选':'多选'}}</button></view><view wx:if="{{selected.length}}" class="row"><text>{{selected.length}} 张</text><button size="mini" class="small" bindtap="selectedActions">更多操作</button></view><view wx:if="{{uploadTotal && uploadDone < uploadTotal}}" class="card">上传 {{uploadDone}} / {{uploadTotal}}<progress percent="{{uploadDone / uploadTotal * 100}}" activeColor="#d3ec8c"/><button size="mini" wx:if="{{!uploading}}" bindtap="resumeUpload">继续／重试 {{uploadFailures}}</button></view><view wx:if="{{error}}" class="error">{{error}}<button size="mini" bindtap="retry">重试</button></view><tasks project-id="{{projectId}}" bindprogress="taskProgress"/><view class="spacer"/><view class="grid"><view wx:for="{{cards}}" wx:key="id" class="photo {{item.selected?'chosen':''}}"><image wx:if="{{!item.imageError}}" src="{{item.url}}" mode="aspectFill" lazy-load data-id="{{item.id}}" bindtap="open" bindlongpress="details" binderror="imageError"/><button size="mini" wx:else data-id="{{item.id}}" bindtap="retryImage">图片加载失败 · 重试</button><view wx:if="{{item.count>1}}" class="badge" data-id="{{item.groupId}}" bindtap="group">{{item.expanded?'收起本组':'相似'}} {{item.count}}</view><text wx:if="{{item.favorite}}" class="tag">♥ 喜欢</text><view><text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" class="tag">{{tag}}</text></view><view class="row"><button size="mini" wx:if="{{stage==='rough'}}" class="small" data-id="{{item.id}}" data-value="maybe" bindtap="decide">待定</button><button size="mini" class="small" data-id="{{item.id}}" data-value="keep" bindtap="decide">保留</button><button size="mini" class="small" data-id="{{item.id}}" data-value="reject" bindtap="decide">不要</button></view></view></view><view wx:if="{{!cards.length && !loading}}" class="empty">当前范围已筛完<button size="mini" wx:if="{{stage==='rough'}}" data-stage="refine" bindtap="stage">进入精筛</button><button size="mini" wx:else data-stage="portfolio" bindtap="stage">进入作品集</button></view><view wx:if="{{pageCount>1}}" class="row pager"><button size="mini" disabled="{{!pageOffset || loading}}" bindtap="prevPage">上一页</button><text>{{pageNumber}} / {{pageCount}}</text><button size="mini" disabled="{{!more || loading}}" bindtap="nextPage">下一页</button></view></view><view wx:if="{{filterOpen}}" class="sheet"><view class="sheet-body bottom"><view class="row between"><text class="section">筛选</text><button size="mini" class="small" bindtap="mode">{{filter.tagMode==='all'?'同时满足':'满足任一'}}</button></view><picker range="{{focals}}" bindchange="focal"><view class="card">{{filter.focal||'全部焦段'}} ▾</view></picker><view class="row"><button size="mini" class="small" data-value="" bindtap="orientation">全部方向</button><button size="mini" class="small" data-value="portrait" bindtap="orientation">竖图</button><button size="mini" class="small" data-value="landscape" bindtap="orientation">横图</button></view><view class="row"><picker mode="date" value="{{filter.from}}" data-key="from" bindchange="date"><button size="mini" class="small">{{filter.from || '开始日期'}}</button></picker><picker mode="date" value="{{filter.to}}" data-key="to" bindchange="date"><button size="mini" class="small">{{filter.to || '结束日期'}}</button></picker><button size="mini" class="small {{filter.favorite?'primary':''}}" bindtap="favorites">喜欢</button></view><view wx:for="{{domains}}" wx:key="name"><view class="section" data-name="{{item.name}}" bindtap="domain">{{item.name}} {{item.selected || ''}} ▾</view><view wx:if="{{openDomain===item.name}}" class="row"><button size="mini" wx:for="{{item.options}}" wx:for-item="tag" wx:key="name" class="small {{tag.selected?'primary':''}}" data-tag="{{tag.name}}" bindtap="tag">{{tag.name}}</button></view></view><view class="spacer"/><view class="row"><button size="mini" bindtap="clearFilters">重置</button><button size="mini" class="primary" bindtap="applyFilters">应用</button></view></view></view>
