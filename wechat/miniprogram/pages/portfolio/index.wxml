<view class="page"><view class="row toolbar nav"><button data-stage="rough" bindtap="stage">粗筛</button><button data-stage="refine" bindtap="stage">精筛</button><button class="primary">作品集</button></view><scroll-view scroll-x class="collection-strip"><button class="small {{!collectionId?'primary':''}}" bindtap="choose">候选池</button><button wx:for="{{collections}}" wx:key="id" class="small {{collectionId===item.id?'primary':''}}" data-id="{{item.id}}" bindtap="choose">{{item.name}} {{item.count}}</button><button class="small" bindtap="create">＋ 新建</button></scroll-view><view wx:if="{{collectionId}}"><view class="row between"><text class="title">{{name}}</text><button class="small" bindtap="edit">描述</button></view><view wx:if="{{description}}" class="muted">{{description}}</view><view class="row"><button class="{{tab==='photos'?'primary':''}}" data-tab="photos" bindtap="tab">照片</button><button class="{{tab==='creations'?'primary':''}}" data-tab="creations" bindtap="tab">创作</button></view></view><tasks id="tasks" project-id="{{projectId}}" bindprogress="progress"/><view class="row toolbar"><button wx:if="{{!collectionId}}" class="small" bindtap="scope">{{unassigned?'未归入作品集':'全部候选'}}</button><button wx:if="{{tab==='photos'}}" class="small" bindtap="filters">筛选</button><button class="small" bindtap="studio">拼图</button><button wx:if="{{collectionId}}" class="small" data-type="copy" bindtap="generate">生成文案</button><button wx:if="{{collectionId}}" class="small" data-type="cover" bindtap="generate">生成封面</button></view><view wx:if="{{selected.length}}" class="row toolbar"><text>{{selected.length}} 张</text><button class="small primary" bindtap="add">加入作品集</button><button wx:if="{{collectionId}}" class="small" bindtap="remove">移出本作品集</button></view><view wx:if="{{error}}" class="error">{{error}}<button bindtap="retry">重试</button></view><view wx:if="{{tab==='photos'}}" class="grid"><view wx:for="{{photos}}" wx:key="id" class="photo {{item.selected?'chosen':''}}"><image src="{{item.url}}" mode="aspectFill" lazy-load data-id="{{item.id}}" bindtap="select" bindlongpress="view"/><view wx:if="{{item.selected}}" class="badge">✓</view><view><text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" class="tag">{{tag}}</text></view></view></view><view wx:else><view wx:for="{{creations}}" wx:key="id" class="card"><text class="tag">{{item.type==='copy'?'文案':item.type==='cover'?'AI 图片':'拼图'}}</text><view class="section">{{item.title}}</view><image wx:if="{{item.url}}" class="creation-image" src="{{item.url}}" mode="widthFix" data-id="{{item.id}}" bindtap="viewCreation"/><view wx:if="{{item.body}}" class="copy">{{item.body}}</view><view class="row"><button class="small" data-id="{{item.id}}" bindtap="download">{{item.type==='copy'?'复制':'存到相册'}}</button><button wx:if="{{item.type==='copy'}}" class="small" data-id="{{item.id}}" bindtap="editCopy">编辑</button><button class="small" data-id="{{item.id}}" bindtap="references">来源照片</button></view></view></view><view wx:if="{{!busy && (tab==='photos'?!photos.length:!creations.length)}}" class="empty">{{tab==='photos'?'暂无入选照片':'暂无创作'}}</view></view><view wx:if="{{filterOpen}}" class="sheet"><view class="sheet-body bottom"><view class="row between"><text class="section">标签筛选</text><button class="small" bindtap="mode">{{filter.tagMode==='all'?'同时满足':'满足任一'}}</button></view><view wx:for="{{domains}}" wx:key="name"><view class="section" data-name="{{item.name}}" bindtap="domain">{{item.name}} {{item.selected || ''}} ▾</view><view wx:if="{{openDomain===item.name}}" class="row"><button wx:for="{{item.options}}" wx:for-item="tag" wx:key="name" class="small {{tag.selected?'primary':''}}" data-tag="{{tag.name}}" bindtap="tag">{{tag.name}}</button></view></view><button class="primary" bindtap="apply">应用</button></view></view><view wx:if="{{editing}}" class="sheet"><view class="sheet-body bottom"><textarea value="{{editing.body}}" maxlength="10000" bindinput="copyInput"/><view class="row"><button bindtap="closeEdit">取消</button><button class="primary" bindtap="saveCopy">保存新版本</button></view></view></view>
