<view class="review bottom"><view class="row between head"><button class="small" bindtap="exit">返回</button><text>{{done?'已筛完':index+1+' / '+total}}</text><button class="small" bindtap="undo" disabled="{{saving}}">撤销</button></view><view wx:if="{{current}}" class="viewer" bindtouchstart="start" bindtouchmove="move" bindtouchend="end"><image wx:for="{{neighbors}}" wx:key="id" wx:if="{{!item.main && zoom===1}}" src="{{item.url}}" class="side {{item.side}} {{item.blur?'blur':''}}" mode="aspectFit" data-id="{{item.id}}" bindtap="choose"/><movable-area class="area {{zoom>1?'zoomed':''}}"><movable-view class="movable" direction="all" scale scale-min="1" scale-max="8" scale-value="{{zoom}}" bindscale="scale" out-of-bounds><image src="{{current.url}}" mode="aspectFit" class="main-image" binderror="imageError"/></movable-view></movable-area><button wx:if="{{imageFailed}}" class="image-retry" bindtap="retryImage">图片加载失败 · 重试</button></view><view class="tags"><text wx:for="{{current.tags}}" wx:key="*this" class="tag">{{item}}</text></view><view wx:if="{{current}}" class="row controls"><button class="small" bindtap="prev">上一张</button><button class="small" bindtap="reset">适应</button><button class="small" bindtap="original">原图</button><button class="small" bindtap="next">下一张</button></view><view wx:if="{{current}}" class="row decisions"><button wx:if="{{stage==='rough'}}" data-value="maybe" bindtap="decide" disabled="{{saving}}">待定</button><button class="primary" data-value="keep" bindtap="decide" disabled="{{saving}}">保留</button><button data-value="reject" bindtap="decide" disabled="{{saving}}">不要</button></view><view wx:if="{{done}}" class="empty">当前范围已筛完<button bindtap="exit">返回照片库</button></view></view>
