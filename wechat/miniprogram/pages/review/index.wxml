<view class="review bottom"><view class="row between head"><button class="small" bindtap="exit">返回</button><text>{{done?'已筛完':index+1+' / '+total}}</text><button class="small" bindtap="undo" disabled="{{saving}}">撤销</button></view><view wx:if="current" class="viewer" bindtouchstart="start" bindtouchmove="move" bindtouchend="end"><movable-area class="area"><movable-view class="movable" direction="all" scale scale-min="1" scale-max="8" scale-value="{{zoom}}" bindscale="scale" out-of-bounds><image src="{{current.url}}" mode="aspectFit" class="main-image"/></movable-view></movable-area></view><view class="neighbors"><image wx:for="{{neighbors}}" wx:key="id" src="{{item.url}}" class="neighbor {{item.main?'focused':''}} {{item.blur?'blur':''}}" mode="aspectFit" data-id="{{item.id}}" bindtap="choose"/></view><view class="tags"><text wx:for="{{current.tags}}" wx:key="*this" class="tag">{{item}}</text></view><view wx:if="current" class="row controls"><button class="small" bindtap="prev">上一张</button><button class="small" bindtap="reset">适应</button><button class="small" bindtap="original">原图</button><button class="small" bindtap="next">下一张</button></view><view wx:if="current" class="row decisions"><button wx:if="stage==='rough'" data-value="maybe" bindtap="decide" disabled="{{saving}}">待定</button><button class="primary" data-value="keep" bindtap="decide" disabled="{{saving}}">保留</button><button data-value="reject" bindtap="decide" disabled="{{saving}}">不要</button></view><view wx:if="done" class="empty">当前范围已筛完<button bindtap="exit">返回照片库</button></view></view>
