.review{height:100vh;display:flex;flex-direction:column;box-sizing:border-box;background:#080a0b}.head{padding:12rpx 24rpx}.viewer{flex:1;min-height:200rpx;position:relative}.area,.movable,.main-image{width:100%;height:100%}.neighbors{display:flex;justify-content:center;gap:12rpx;height:130rpx;margin:16rpx}.neighbor{width:26%;height:110rpx;opacity:.7;border:2rpx solid transparent}.neighbor.focused{opacity:1;transform:scale(1.08);border-color:#d3ec8c}.blur{filter:blur(4rpx);opacity:.4}.tags{text-align:center;padding:0 20rpx}.controls,.decisions{justify-content:center;padding:16rpx}.decisions button{flex:1}.chosen{outline:3rpx solid #d3ec8c}
.area{position:absolute;left:14%;width:72%;z-index:1}.area.zoomed{left:0;width:100%}.side{position:absolute;top:20%;height:60%;width:24%}.side.left{left:-10%}.side.right{right:-10%}.viewer{overflow:hidden}.image-retry{position:absolute;top:45%;left:20%;z-index:3}