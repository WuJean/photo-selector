<view class="page"><view class="row between"><text class="title">拼图</text><text class="muted">{{scopeName}}</text></view><tasks id="tasks" project-id="{{projectId}}" bindprogress="progress"/><view wx:if="{{error}}" class="error">{{error}}<button size="mini" bindtap="load">重试</button></view><block wx:if="{{draft}}"><view class="canvas" style="{{canvasStyle}}"><view wx:for="{{tiles}}" wx:key="index" class="tile {{active===index?'chosen':''}}" style="{{item.style}}" data-index="{{index}}" bindtap="active"><image wx:if="{{item.url}}" src="{{item.url}}" mode="scaleToFill" style="{{item.imageStyle}}"/><text wx:else class="placeholder">＋ {{index+1}}</text><text wx:if="{{item.locked}}" class="locked">锁定</text></view><text wx:if="{{draft.frame==='caption'}}" class="caption" style="{{captionStyle}}">{{caption}}</text><image wx:if="{{logoURL}}" src="{{logoURL}}" class="watermark" style="{{logoStyle}}" mode="aspectFit"/><text class="watermark" style="{{watermarkStyle}}">{{draft.watermark.text}}</text></view><view class="row toolbar"><button size="mini" class="small primary" bindtap="replace">{{slot?'替换':'添加照片'}}</button><button size="mini" class="small" bindtap="fit">{{slot.fit==='contain'?'填充':'适应'}}</button><button size="mini" class="small" bindtap="swap">交换</button><button size="mini" class="small" bindtap="lock">{{slot.locked?'解锁':'锁定'}}</button></view><view wx:if="{{slot}}"><view class="adjust"><text>缩放</text><slider min="100" max="400" value="{{slot.zoom*100}}" data-key="zoom" bindchange="slotChange" activeColor="#d3ec8c"/></view><view class="adjust"><text>左右</text><slider min="0" max="1000" value="{{slot.cx*1000}}" data-key="cx" bindchange="slotChange" activeColor="#d3ec8c"/></view><view class="adjust"><text>上下</text><slider min="0" max="1000" value="{{slot.cy*1000}}" data-key="cy" bindchange="slotChange" activeColor="#d3ec8c"/></view></view><view class="card"><view class="row"><picker range="{{templateNames}}" value="{{templateIndex}}" bindchange="template"><button size="mini" class="small">{{templateNames[templateIndex]}} ▾</button></picker><picker range="{{ratios}}" value="{{ratioIndex}}" bindchange="ratio"><button size="mini" class="small">{{draft.ratio}} ▾</button></picker><picker range="{{frames}}" value="{{frameIndex}}" bindchange="frame"><button size="mini" class="small">{{frames[frameIndex]}} ▾</button></picker></view><view class="adjust"><text>间距</text><slider min="0" max="80" value="{{draft.gap*1000}}" bindchange="gap" activeColor="#d3ec8c"/></view><input value="{{draft.background}}" bindblur="background" placeholder="背景色 #f5f3ed"/><input value="{{draft.watermark.text}}" bindblur="watermark" placeholder="文字水印" maxlength="80"/><view class="row"><button size="mini" class="small" bindtap="logo">PNG 水印</button><button size="mini" wx:if="{{logoURL}}" class="small" bindtap="removeLogo">移除图片水印</button></view></view><view class="card"><view class="row between"><text class="section">快捷搭配</text><button size="mini" class="small" bindtap="newPreset">自定义</button></view><picker range="{{presets}}" range-key="name" value="{{presetIndex}}" bindchange="preset"><view class="preset">{{presets[presetIndex].name}} ▾</view></picker><button size="mini" class="primary" disabled="{{busy}}" bindtap="random">随机组合</button></view><view class="card"><textarea value="{{prompt}}" bindinput="prompt" placeholder="例如：清冷风格，人像近景、风景远景、人像远景" maxlength="3000"/><button size="mini" disabled="{{busy}}" bindtap="recommend">AI 看图搭配</button><view wx:if="{{proposal}}"><view>{{proposal.reason}}</view><view class="muted">{{proposal.missing}}</view><view class="row"><button size="mini" bindtap="dismiss">放弃</button><button size="mini" class="primary" bindtap="applyProposal">应用搭配</button></view></view></view><button size="mini" class="primary" disabled="{{busy}}" bindtap="export">保存成品到作品集</button></block></view><view wx:if="{{replaceOpen}}" class="sheet"><view class="sheet-body bottom"><view class="row between"><text class="section">选择照片</text><button size="mini" class="small" bindtap="closeReplace">完成</button></view><scroll-view scroll-y class="picker-grid" bindscrolltolower="morePhotos"><view class="grid"><image wx:for="{{photos}}" wx:key="id" src="{{item.url}}" mode="aspectFill" data-id="{{item.id}}" bindtap="pick"/></view></scroll-view></view></view><view wx:if="{{editor}}" class="sheet"><view class="sheet-body bottom"><input value="{{editor.name}}" bindinput="presetName" placeholder="模板名称" maxlength="60"/><picker range="{{templateNames}}" bindchange="presetLayout"><view class="section">布局 {{editor.template}} ▾</view></picker><view wx:for="{{editor.roles}}" wx:key="index" class="row card"><text>第 {{index+1}} 格</text><picker range="{{subjectOptions}}" value="{{item.subjectIndex}}" data-index="{{index}}" data-key="subject" bindchange="presetRole"><button size="mini" class="small">{{subjectOptions[item.subjectIndex]}} ▾</button></picker><picker range="{{shotOptions}}" value="{{item.shotIndex}}" data-index="{{index}}" data-key="shot" bindchange="presetRole"><button size="mini" class="small">{{shotOptions[item.shotIndex]}} ▾</button></picker></view><view class="row"><button size="mini" bindtap="closePreset">取消</button><button size="mini" class="primary" bindtap="savePreset">保存模板</button></view></view></view>
