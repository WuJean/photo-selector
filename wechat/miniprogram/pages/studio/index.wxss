.canvas{position:relative;margin:0 auto;overflow:hidden}.tile{position:absolute;overflow:hidden;box-sizing:border-box}.tile image{position:absolute;max-width:none}.chosen{outline:4rpx solid #d3ec8c;outline-offset:-4rpx;z-index:1}.placeholder{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:#525a4b}.locked{position:absolute;left:10rpx;top:10rpx;font-size:20rpx;color:white;background:#0008}.watermark{position:absolute;pointer-events:none;z-index:2;white-space:nowrap}.caption{position:absolute;bottom:3%;left:4%;color:#3f433c;font-size:20rpx}.adjust{display:flex;align-items:center}.adjust text{width:60rpx;font-size:24rpx}.adjust slider{flex:1}.picker-grid{height:60vh}.picker-grid image{width:100%;height:280rpx}.preset{margin-bottom:20rpx}textarea{height:160rpx;margin-bottom:20rpx}input{margin-top:16rpx}
