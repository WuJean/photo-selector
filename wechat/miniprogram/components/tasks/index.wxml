<view wx:for="{{jobs}}" wx:key="id" class="task"><view>{{item.label}} {{item.completed + item.skipped}} / {{item.total}} · 处理中 {{item.processing || 0}}<text wx:if="{{item.failed}}"> · 失败 {{item.failed}}</text></view><progress percent="{{item.percent}}" activeColor="#d3ec8c"/><view class="error" wx:if="{{item.error}}">{{item.error}}</view><view class="actions"><button wx:if="{{item.state==='confirmation'}}" data-id="{{item.id}}" bindtap="open">确认标签库</button><button wx:elif="{{item.state==='paused'}}" data-id="{{item.id}}" data-action="{{item.failed ? 'retry' : 'resume'}}" bindtap="control">继续</button><button wx:elif="{{item.state==='failed'}}" data-id="{{item.id}}" data-action="retry" bindtap="control">重试失败</button><button wx:else data-id="{{item.id}}" data-action="pause" bindtap="control">暂停</button><button data-id="{{item.id}}" data-action="cancel" bindtap="control">取消</button></view></view>
