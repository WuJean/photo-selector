page{background:#17191b;color:#e7e8e3;font-family:-apple-system,sans-serif;font-size:28rpx}button{font-size:26rpx;color:#e7e8e3;background:#2a2d2f;border-radius:16rpx;margin:0}button::after{border:0}button[disabled]{opacity:.4}.primary{background:#d3ec8c;color:#17200d}.page{padding:28rpx}.row{display:flex;align-items:center;gap:16rpx;flex-wrap:wrap}.between{justify-content:space-between}.muted{color:#919799;font-size:24rpx}.title{font-size:42rpx;font-weight:600;margin:12rpx 0 28rpx}.card{background:#222628;border:1rpx solid #353b3d;border-radius:22rpx;padding:24rpx;margin:20rpx 0}.empty{padding:120rpx 32rpx;text-align:center;color:#919799}input,textarea{background:#2a2d2f;padding:20rpx;border-radius:12rpx;color:white;box-sizing:border-box;width:100%}.error{color:#f6b6a5;padding:20rpx}.tag{font-size:22rpx;background:#343b32;padding:6rpx 12rpx;border-radius:8rpx;display:inline-block;margin:4rpx}.active{color:#d3ec8c;border-color:#d3ec8c}.toolbar{position:sticky;top:0;z-index:4;background:#17191b;padding:16rpx 0}.small{font-size:22rpx;padding:0 16rpx}.grid{display:grid;grid-template-columns:1fr 1fr;gap:12rpx}.photo{border-radius:12rpx;background:#24282a;overflow:hidden;position:relative}.photo image{width:100%;height:320rpx}.badge{position:absolute;top:10rpx;left:10rpx;background:#17191be0;border-radius:8rpx;padding:8rpx;font-size:22rpx}.sheet{position:fixed;inset:0;z-index:20;background:#0009;display:flex;align-items:flex-end}.sheet-body{background:#222628;width:100%;max-height:85vh;padding:28rpx;box-sizing:border-box;overflow:auto;border-radius:28rpx 28rpx 0 0}.section{font-weight:600;margin:26rpx 0 14rpx}.spacer{height:30rpx}.bottom{padding-bottom:env(safe-area-inset-bottom)}
button{width:auto;box-sizing:border-box;padding:0 24rpx;line-height:2.6}.row>button{flex:0 0 auto}.nav{display:flex;flex-wrap:nowrap}.nav>button{flex:1;min-width:0;padding:0 10rpx}.collection-strip button{width:auto}.card>button{width:100%}
button[size=mini]{font-size:26rpx;line-height:2.6}.small[size=mini]{font-size:22rpx;padding:0 12rpx}.photo .row{flex-wrap:nowrap;gap:4rpx}.photo .row button[size=mini]{flex:1;min-width:0;padding:0;font-size:22rpx}
.pager{justify-content:center;margin:32rpx 0 60rpx}
